# ==============================================================================
# XIMPLY Vision Backend Dockerfile
# Multi-stage build for Python FastAPI application
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Builder
# ------------------------------------------------------------------------------
FROM python:3.11-slim as builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files
COPY backend/pyproject.toml backend/requirements.txt* ./

# Create virtual environment and install dependencies
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies
# INSTALL_GPU swaps the ONNX runtime for the build carrying the CUDA execution
# provider, which is what moves face recognition onto the GPU. A build argument
# rather than a runtime check, because the two wheels cannot coexist and a CPU
# only image should not carry a GPU wheel it can never use.
ARG INSTALL_GPU=false

# INSTALL_DEV adds the test and linting tools, so the suite can be run inside
# the container it will actually run against rather than only against whatever
# a developer happens to have installed on the host. Off by default: a
# production image has no reason to carry a test runner.
ARG INSTALL_DEV=false

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir ".[ml]" && \
    if [ "$INSTALL_GPU" = "true" ]; then \
        pip uninstall -y onnxruntime && \
        pip install --no-cache-dir ".[gpu]"; \
    fi && \
    if [ "$INSTALL_DEV" = "true" ]; then \
        pip install --no-cache-dir ".[dev]"; \
    fi

# ------------------------------------------------------------------------------
# Stage 2: Production
# ------------------------------------------------------------------------------
FROM python:3.11-slim as production

# Create non-root user
RUN groupadd --gid 1000 appgroup && \
    useradd --uid 1000 --gid appgroup --shell /bin/bash --create-home appuser

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libzbar0 \
    # The MediaPipe tasks runtime links against EGL and GLES even when it runs
    # on CPU, and refuses to create a landmarker without them.
    libegl1 \
    libgles2 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# On a GPU build, PyTorch reaches Triton, which compiles its CUDA helper module
# from C source the first time it is used and fails outright without a compiler.
# Attention was switched to eager and the compiled backends disabled to avoid
# this, and neither was enough, so the toolchain is installed rather than
# pretended away. Only on the GPU image: a CPU install never reaches that path
# and should not carry the weight.
ARG INSTALL_GPU=false
RUN if [ "$INSTALL_GPU" = "true" ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
            gcc g++ python3-dev \
        && rm -rf /var/lib/apt/lists/*; \
    fi

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./
# Carries [tool.pytest.ini_options], which is what makes a bare "pytest" behave
# the same here as it does on a developer's machine. The development compose
# file mounts the tests themselves over this image.
COPY backend/pyproject.toml ./

# Create directories
# The model caches are named volumes at runtime. Docker seeds a fresh volume
# from the image, ownership included, so these must exist and belong to appuser
# here, or the container is handed a root owned directory it cannot write and
# every model download fails with a permission error.
RUN mkdir -p /app/storage /app/models/weights \
        /home/appuser/.insightface /home/appuser/.cache/huggingface && \
    chown -R appuser:appgroup /app /home/appuser

# Switch to non-root user
USER appuser

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    # Keep PyTorch off its compiled backends. They invoke a C compiler at run
    # time through Triton, which a slim runtime image has no reason to ship,
    # and the speedup is not worth the weight for a paragraph of text.
    TORCHINDUCTOR_DISABLE=1 \
    TORCHDYNAMO_DISABLE=1

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health/live || exit 1

# Run application
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
