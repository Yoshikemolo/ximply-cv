# ==============================================================================
# XIMPLY Vision - Development Environment Variables
# ==============================================================================
# Copy this file to .env for development use:
#   cp .env.development.example .env

# Application
APP_NAME=XIMPLY Vision (Dev)
APP_VERSION=1.0.0-dev
API_VERSION=v1
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
BACKEND_PORT=8000
FRONTEND_PORT=4200

# Database
DB_USER=postgres
DB_PASSWORD=devpassword
DB_NAME=ximply_vision_dev
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:devpassword@db:5432/ximply_vision_dev

# MinIO
MINIO_ACCESS_KEY=devadmin
MINIO_SECRET_KEY=devpassword
MINIO_BUCKET=ximply-vision-dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false

# JWT
JWT_SECRET_KEY=dev-secret-key-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:4200", "http://127.0.0.1:4200"]

# Services
USE_MOCK_SERVICES=true

# Build
BUILD_CONFIGURATION=development

# Detection
DETECTION_MODEL=yolov8n
DETECTION_CONFIDENCE_THRESHOLD=0.5
