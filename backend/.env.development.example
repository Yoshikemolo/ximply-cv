# ==============================================================================
# XIMPLY Vision - Development Environment
# ==============================================================================

# Application
APP_NAME=XIMPLY Vision (Dev)
APP_VERSION=1.0.0-dev
API_VERSION=v1
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database (Docker Compose development)
DATABASE_URL=postgresql+asyncpg://postgres:devpassword@localhost:5432/ximply_vision_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30

# MinIO (Docker Compose development)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=devadmin
MINIO_SECRET_KEY=devpassword
MINIO_BUCKET=ximply-vision-dev
MINIO_SECURE=false

# JWT (Development key - DO NOT use in production)
JWT_SECRET_KEY=dev-secret-key-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:4200", "http://127.0.0.1:4200"]

# Storage
STORAGE_BASE_PATH=./storage
UPLOAD_PATH=./storage/uploads
MODELS_PATH=./models/weights

# ML Detection
DETECTION_MODEL=yolov8n
DETECTION_CONFIDENCE_THRESHOLD=0.5
DETECTION_IOU_THRESHOLD=0.45

# Mock services for development
USE_MOCK_SERVICES=true

# Camera
CAMERA_FRAME_RATE=30
CAMERA_RESOLUTION_WIDTH=1280
CAMERA_RESOLUTION_HEIGHT=720
