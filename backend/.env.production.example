# ==============================================================================
# XIMPLY Vision - Production Environment
# ==============================================================================

# Application
APP_NAME=XIMPLY Vision
APP_VERSION=1.0.0
API_VERSION=v1
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database (Production)
DATABASE_URL=postgresql+asyncpg://ximply_user:STRONG_PASSWORD_HERE@db:5432/ximply_vision
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# MinIO (Production)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_THIS_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_THIS_SECRET_KEY
MINIO_BUCKET=ximply-vision
MINIO_SECURE=false

# JWT (Production - MUST use secure key)
JWT_SECRET_KEY=GENERATE_A_SECURE_RANDOM_STRING_AT_LEAST_64_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Production domains)
CORS_ORIGINS=["https://ximply-vision.example.com"]

# Storage
STORAGE_BASE_PATH=/app/storage
UPLOAD_PATH=/app/storage/uploads
MODELS_PATH=/app/models/weights

# ML Detection
DETECTION_MODEL=yolov8n
DETECTION_CONFIDENCE_THRESHOLD=0.5
DETECTION_IOU_THRESHOLD=0.45

# Services
USE_MOCK_SERVICES=false

# Camera
CAMERA_FRAME_RATE=30
CAMERA_RESOLUTION_WIDTH=1920
CAMERA_RESOLUTION_HEIGHT=1080
