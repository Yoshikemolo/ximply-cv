# ==============================================================================
# XIMPLY Vision - Production Environment Variables
# ==============================================================================
# Copy this file to .env for production use:
#   cp .env.production.example .env
#
# IMPORTANT: Change all secrets and credentials before deploying!

# Application
APP_NAME=XIMPLY Vision
APP_VERSION=1.0.0
API_VERSION=v1
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
BACKEND_PORT=8000
FRONTEND_PORT=80

# Database - CHANGE THESE CREDENTIALS!
DB_USER=ximply_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_NAME=ximply_vision
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://ximply_user:CHANGE_THIS_STRONG_PASSWORD@db:5432/ximply_vision

# MinIO - CHANGE THESE CREDENTIALS!
MINIO_ACCESS_KEY=CHANGE_THIS_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_THIS_SECRET_KEY
MINIO_BUCKET=ximply-vision
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# JWT - GENERATE A SECURE KEY!
# Use: openssl rand -hex 64
JWT_SECRET_KEY=GENERATE_A_SECURE_64_CHARACTER_RANDOM_STRING_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - Update with your production domain
CORS_ORIGINS=["https://ximply-vision.your-domain.com"]

# Services
USE_MOCK_SERVICES=false

# Build
BUILD_CONFIGURATION=production

# Detection
DETECTION_MODEL=yolov8n
DETECTION_CONFIDENCE_THRESHOLD=0.5
