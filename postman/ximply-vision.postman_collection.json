            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Detection",
      "item": [
        {
          "name": "Get Camera State",
          "request": {
            "method": "GET",
            "header": [],
            "description": "The state a camera is wanted in, and whether it is actually running. 'running' is decided by frames arriving for detection, never by what was asked for, so 'pending' true means the request was recorded and no view is open to honour it. Needs detection:view.",
            "url": {
              "raw": "{{baseUrl}}/detection/camera",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "detection",
                "camera"
              ],
              "query": [
                {
                  "key": "camera_id",
                  "value": "default",
                  "description": "",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Set Camera State",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Ask a camera to start or stop. The camera belongs to the browser, so this records a request that an open view honours. Needs camera:control, which has to be named on the token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"on\": true,\n  \"cameraId\": \"default\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/detection/camera",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "detection",
                "camera"
              ]
            }
          }
        },
        {
          "name": "Capture Detection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Capture a detected object and add it to the catalog.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image\": \"data:image/jpeg;base64,REPLACE_WITH_A_BASE64_FRAME\",\n  \"bbox\": {\n    \"x\": 100,\n    \"y\": 80,\n    \"width\": 220,\n    \"height\": 180\n  },\n  \"name\": \"Stapler\",\n  \"description\": \"Captured from the live view\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/detection/capture",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "detection",
                "capture"
              ]
            }
          }
        },
        {
          "name": "Load Catalog Features",
          "request": {
            "method": "POST",
            "header": [],
            "description": "Load catalog object features for custom object recognition.",
            "url": {
              "raw": "{{baseUrl}}/detection/catalog/load",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "detection",
                "catalog",
                "load"
              ]
            }
          }
        },
        {
          "name": "Get Detection Config",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Get detection configuration settings.",
            "url": {
              "raw": "{{baseUrl}}/detection/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "detection",
                "config"
              ]
            }
          }
        },
        {
          "name": "Update Detection Config",
          "request": {
            "method": "PUT",
            "header": [],
            "description": "Update detection configuration.",
            "url": {
              "raw": "{{baseUrl}}/detection/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "detection",
                "config"
              ],
              "query": [
                {
                  "key": "confidence_threshold",
                  "value": "0.0",
                  "description": "",
                  "disabled": true
                },
                {
                  "key": "iou_threshold",
                  "value": "0.0",
                  "description": "",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Describe Scene",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
