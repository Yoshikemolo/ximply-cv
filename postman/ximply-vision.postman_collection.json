            "description": "Write a short description of what the camera is looking at.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image\": \"data:image/jpeg;base64,REPLACE_WITH_A_BASE64_FRAME\",\n  \"detections\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/detection/describe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "detection",
                "describe"
              ]
            }
          }
        },
        {
          "name": "Description Status",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Report whether the description model is loaded and usable.",
            "url": {
              "raw": "{{baseUrl}}/detection/describe/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "detection",
                "describe",
                "status"
              ]
            }
          }
        },
        {
          "name": "Detect Objects",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Detect objects in a single image.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image\": \"data:image/jpeg;base64,REPLACE_WITH_A_BASE64_FRAME\",\n  \"confidenceThreshold\": 0.5,\n  \"iouThreshold\": 0.45,\n  \"hidePersonDetections\": false,\n  \"showOnlyCustomObjects\": false,\n  \"includeSkeletons\": true,\n  \"includeFaceMesh\": true,\n  \"detectionModel\": \"yolo\",\n  \"cameraId\": \"default\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/detection/detect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "detection",
                "detect"
              ]
            }
          }
        },
        {
          "name": "Start Detection",
          "request": {
            "method": "POST",
            "header": [],
            "description": "Start detection on a specific camera.",
            "url": {
              "raw": "{{baseUrl}}/detection/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "detection",
                "start"
              ],
              "query": [
                {
                  "key": "camera_id",
                  "value": "default",
                  "description": "",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Detection Status",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Get current detection session status.",
            "url": {
              "raw": "{{baseUrl}}/detection/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "detection",
                "status"
              ]
            }
          }
        },
        {
          "name": "Stop Detection",
          "request": {
            "method": "POST",
            "header": [],
            "description": "Stop the current detection session.",
            "url": {
              "raw": "{{baseUrl}}/detection/stop",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "detection",
                "stop"
              ]
            }
          }
        },
        {
          "name": "Stream Detections",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Stream real-time object detections via Server-Sent Events.",
            "url": {
              "raw": "{{baseUrl}}/detection/stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "detection",
                "stream"
              ]
            }
          }
        },
        {
          "name": "Refresh Object Features",
          "request": {
            "method": "POST",
            "header": [],
            "description": "Refresh features for a specific catalog object.",
            "url": {
              "raw": "{{baseUrl}}/detection/catalog/refresh/:object_id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "detection",
                "catalog",
                "refresh",
                ":object_id"
              ],
              "variable": [
                {
                  "key": "object_id",
                  "value": "{{object_id}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Objects",
      "item": [
        {
          "name": "List Objects",
          "request": {
            "method": "GET",
            "header": [],
            "description": "List catalog objects with pagination and filters.",
            "url": {
              "raw": "{{baseUrl}}/objects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "objects"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "",
                  "disabled": true
                },
                {
                  "key": "page_size",
                  "value": "20",
                  "description": "",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "",
                  "disabled": true
                },
                {
                  "key": "category_id",
                  "value": "{{objectId}}",
                  "description": "",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "",
                  "disabled": true
                }
              ]
            }
          }
        },
