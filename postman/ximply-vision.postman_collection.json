{
  "info": {
    "name": "XIMPLY Vision API",
    "description": "API collection for XIMPLY Vision - Computer Vision Object Detection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "event_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "file_path",
      "value": "",
      "type": "string"
    },
    {
      "key": "image_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "object_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "subscription_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "camera_id",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Check application health status.",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Acceleration Status",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Report whether inference is running on dedicated hardware.",
            "url": {
              "raw": "{{baseUrl}}/health/acceleration",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "acceleration"
              ]
            }
          }
        },
        {
          "name": "Set Acceleration",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Move one inference backend between the processor and the accelerator. The models affected are dropped and rebuild on the next frame.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"backend\": \"string\",\n  \"enabled\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/health/acceleration",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "acceleration"
              ]
            }
          }
        },
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Kubernetes liveness probe endpoint.",
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ]
            }
          }
        },
        {
          "name": "Mcp Status",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Whether the Model Context Protocol is built into this deployment ('available', set by MCP_ENABLED and read at startup) and whether it is currently open ('enabled', the runtime switch behind the footer control). Public.",
            "url": {
              "raw": "{{baseUrl}}/health/mcp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "mcp"
              ]
            }
          }
        },
        {
          "name": "Set Mcp",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Open or close the protocol without restarting. A closed protocol keeps both transports mounted and answers 503, so a connected agent gets an answer rather than a hole. Needs events:manage. A deployment started without the protocol answers 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/health/mcp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "mcp"
              ]
            }
          }
        },
        {
          "name": "Readiness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Kubernetes readiness probe endpoint.",
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            }
          }
        }
      ]
    },
    {
