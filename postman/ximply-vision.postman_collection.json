{
  "info": {
    "name": "XIMPLY Vision API",
    "description": "API collection for XIMPLY Vision - Computer Vision Object Detection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": ["{{baseUrl}}"],
              "path": ["health", "live"]
            }
          }
        },
        {
          "name": "Readiness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": ["{{baseUrl}}"],
              "path": ["health", "ready"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.test('User created successfully', function() {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.id).to.exist;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"SecurePass123\",\n  \"fullName\": \"Test User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "    pm.test('Login successful', function() {",
                  "        pm.expect(jsonData.accessToken).to.exist;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Objects",
      "item": [
        {
          "name": "List Objects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/objects?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["objects"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "categoryId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Create Object",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample Object\",\n  \"description\": \"A sample object for testing\",\n  \"reference\": \"OBJ001\",\n  \"weight\": 1.5,\n  \"weightUnit\": \"kg\",\n  \"dimensions\": {\n    \"width\": 10,\n    \"height\": 20,\n    \"depth\": 5,\n    \"unit\": \"cm\"\n  },\n  \"price\": 29.99,\n  \"currency\": \"EUR\",\n  \"color\": \"Blue\",\n  \"materials\": [\"plastic\", \"metal\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/objects",
              "host": ["{{baseUrl}}"],
              "path": ["objects"]
            }
          }
        },
        {
          "name": "Get Object",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/objects/:objectId",
              "host": ["{{baseUrl}}"],
              "path": ["objects", ":objectId"],
              "variable": [
                {
                  "key": "objectId",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Update Object",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Object Name\",\n  \"description\": \"Updated description\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/objects/:objectId",
              "host": ["{{baseUrl}}"],
              "path": ["objects", ":objectId"],
              "variable": [
                {
                  "key": "objectId",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Delete Object",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/objects/:objectId",
              "host": ["{{baseUrl}}"],
              "path": ["objects", ":objectId"],
              "variable": [
                {
                  "key": "objectId",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Upload Object Image",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "is_primary",
                  "value": "false",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/objects/:objectId/images",
              "host": ["{{baseUrl}}"],
              "path": ["objects", ":objectId", "images"],
              "variable": [
                {
                  "key": "objectId",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "List Object Images",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/objects/:objectId/images",
              "host": ["{{baseUrl}}"],
              "path": ["objects", ":objectId", "images"],
              "variable": [
                {
                  "key": "objectId",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Delete Object Image",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/objects/:objectId/images/:imageId",
              "host": ["{{baseUrl}}"],
              "path": ["objects", ":objectId", "images", ":imageId"],
              "variable": [
                {
                  "key": "objectId",
                  "value": ""
                },
                {
                  "key": "imageId",
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Detection",
      "item": [
        {
          "name": "Start Detection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cameraId\": \"default\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/detection/start",
              "host": ["{{baseUrl}}"],
              "path": ["detection", "start"]
            }
          }
        },
        {
          "name": "Stop Detection",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/detection/stop",
              "host": ["{{baseUrl}}"],
              "path": ["detection", "stop"]
            }
          }
        },
        {
          "name": "Get Detection Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/detection/status",
              "host": ["{{baseUrl}}"],
              "path": ["detection", "status"]
            }
          }
        },
        {
          "name": "Get Detection Config",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/detection/config",
              "host": ["{{baseUrl}}"],
              "path": ["detection", "config"]
            }
          }
        },
        {
          "name": "Update Detection Config",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confidenceThreshold\": 0.5,\n  \"iouThreshold\": 0.45\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/detection/config",
              "host": ["{{baseUrl}}"],
              "path": ["detection", "config"]
            }
          }
        },
        {
          "name": "Get Camera State",
          "request": {
            "method": "GET",
            "header": [],
            "description": "The state a camera is wanted in, and whether it is actually running. 'running' is decided by frames arriving for detection, never by what was asked for, so 'pending' true means the request was recorded and no view is open to honour it. Needs detection:view.",
            "url": {
              "raw": "{{baseUrl}}/detection/camera?camera_id=default",
              "host": ["{{baseUrl}}"],
              "path": ["detection", "camera"],
              "query": [
                {
                  "key": "camera_id",
                  "value": "default"
                }
              ]
            }
          }
        },
        {
          "name": "Set Camera State",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Ask a camera to start or stop. The camera belongs to the browser, so this records a request that an open view honours. Needs camera:control, which has to be named on the token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"on\": true,\n  \"cameraId\": \"default\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/detection/camera",
              "host": ["{{baseUrl}}"],
              "path": ["detection", "camera"]
            }
          }
        }
      ]
    },
