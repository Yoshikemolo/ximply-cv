            "description": "Create a new catalog object.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Stapler\",\n  \"description\": \"Black, office\",\n  \"reference\": \"SKU-0001\",\n  \"weight\": 0.4\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/objects",
